LISTEN_ADDR=:8080
WEBHOOK_SECRET_HEADER=change-me
WEBHOOK_MAX_CLOCK_SKEW_SECONDS=300
SQLITE_PATH=/data/events.db
DEDUP_TTL_HOURS=168
TELEGRAM_BOT_TOKEN=change-me
